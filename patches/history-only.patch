@@ -449,0 +450,19 @@ fn judgment_omits_retained_image_bytes_and_opaque_checkpoints_without_mutating_h
+
+#[test]
+fn paseo_writes_unknown_tools_and_failed_reads_are_pinned() {
+    for name in ["apply_patch", "exec_command", "shell", "mcp_write"] {
+        let mut items = history();
+        items[1] =
+            item(json!({"type":"function_call","name":name,"call_id":"old","arguments":"{}"}));
+        assert_eq!(candidate_groups(&items), Vec::<Vec<usize>>::new());
+    }
+    for output in [
+        r#"{"wall_time_seconds":1,"exit_code":1,"output":"failure"}"#,
+        r#"{"wall_time_seconds":1,"exit_code":0,"session_id":7,"output":"running"}"#,
+    ] {
+        let mut items = history();
+        items[2] = pair("old", output).remove(1);
+        assert_eq!(candidate_groups(&items), Vec::<Vec<usize>>::new());
+    }
+    assert_eq!(candidate_groups(&history()), vec![vec![1, 2]]);
+}
